# Browser configuration for the future connected Ola app (SCRUM-40).
# Copy to .env.local for local development. Use values from the intended
# isolated Supabase environment; never commit actual keys or project URLs.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Privileged Supabase credentials, database passwords, bootstrap account
# passwords, and deploy tokens belong only in protected backend/CI secrets.
# Do not prefix privileged values with VITE_: Vite exposes those to browsers.
