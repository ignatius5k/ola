{
  "name": "ola-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test src/engine.test.js",
    "preview": "vite preview --host 127.0.0.1",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:advisors": "supabase db advisors --type all --level info",
    "db:types": "supabase gen types typescript --schema public > src/db/database.types.ts",
    "db:seed:generate": "node scripts/generate-seed.mjs",
    "db:verify:plain": "bash scripts/verify-plain-postgres.sh"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "supabase": "3.0.0",
    "vite": "8.3.5"
  }
}
